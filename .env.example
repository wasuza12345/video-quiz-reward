# Local SQLite file (dev, tests, CI).
DATABASE_URL="file:./dev.db"

# Turso — set by Vercel / `vercel env pull .env.local`. When set, the app uses Turso instead of DATABASE_URL.
# This is the single shared (prod) DB: never set these for tests or CI.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Each at least 32 characters, e.g. `openssl rand -base64 48`
ADMIN_SESSION_SECRET=""
USER_COOKIE_SECRET=""

# Seed only — first admin (password at least 12 characters)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
